{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Fleet": ""
  },
  "Jwt": {
    "Issuer": "ControleDeFrota",
    "Audience": "ControleDeFrota",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RequestsPerMinutePerIp": 10,
    "RefreshCookie": {
      "Secure": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Storage": {
    "LocalRootPath": "App_Data/files"
  },
  "Jobs": {
    "DocumentExpirationScan": {
      "Enabled": true,
      "IntervalMinutes": 360
    },
    "Automation": {
      "Enabled": true,
      "IntervalMinutes": 60
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false,
    "SeedSampleData": false
  }
}
